# Python
__pycache__/
*.pyc

# Enclosure build outputs: regenerated by the scripts in hardware/enclosure.
# Only the printable results are kept in git (Bambu projects, print STLs, renders).
hardware/enclosure/out/*
!hardware/enclosure/out/bambu/
!hardware/enclosure/out/print/
!hardware/enclosure/out/render/
hardware/enclosure/out/bambu/*
!hardware/enclosure/out/bambu/*.3mf
